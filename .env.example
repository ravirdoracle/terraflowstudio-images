# Set both credentials before starting the container.
# Use plain values, without surrounding quotes.
APP_AUTH_USER=admin
APP_AUTH_PASSWORD=

# Optional AI integration. Basic Terraform generation works without an API key.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=60

# Optional: push generated Terraform files to a GitHub repository.
# This token is not needed to download or load the image archive.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_BASE_PATH=terraform
